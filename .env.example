# Copy to .env and fill in. Never commit .env.
APOLLO_API_KEY=

# Models for writing emails, follow-ups, reply triage and contact picking.
# Set at least one. With no LLM_PROVIDERS, the free tiers are tried in order
# (Gemini, then Groq) and Claude is used only when neither free key is set.
# Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: Gemini models to try, in order. Each has its own free quota.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: the order to try providers in. Add claude to fall back to it (paid).
# LLM_PROVIDERS=gemini,groq,claude

# Claude (paid). Required for the résumé tailor and résumé matching, and for
# writing emails only when listed in LLM_PROVIDERS or no free key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — enables Hunter.io Email Finder fallback when Apollo returns no email.
HUNTER_API_KEY=
